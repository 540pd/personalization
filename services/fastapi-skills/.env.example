# GCOS FastAPI Skills service: every setting app/config.py reads.
# Copy to .env (git-ignored) and fill in. Use a non-production project first.

# Agent Registry governance project, and where its Skills live.
GOOGLE_CLOUD_PROJECT=
REGISTRY_LOCATION=us
REGISTRY_API_VERSION=v1alpha
REGISTRY_BASE_URL=https://agentregistry.googleapis.com

# Firestore project for Skill ownership, publish operations and quotas.
FIRESTORE_PROJECT_ID=

# The caller check (app/security.py): this service's own Cloud Run URL, and the
# one Node BFF service account allowed to call it.
FASTAPI_AUDIENCE=
NODE_SERVICE_ACCOUNT=

# The AI draft helper (Vertex AI Gemini).
VERTEX_LOCATION=us-central1
SKILL_HELPER_MODEL=gemini-3.5-flash-lite
SKILL_HELPER_MAX_OUTPUT_TOKENS=2048
# Its bounds (#511; placeholders): `fake` answers without a model, and is refused on Cloud Run.
SKILL_HELPER_BACKEND=gemini
SKILL_HELPER_TIMEOUT_SECONDS=30
SKILL_HELPER_DRAFTS_PER_HOUR=20
SKILL_HELPER_MAX_PROMPT_CHARS=8000

# LOCAL ONLY: skips the service-token check (X-Owner-Key is still required).
# Refused on Cloud Run. Bind to localhost if you turn it on.
DEV_BYPASS_AUTH=false
