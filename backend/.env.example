# Each service runs on a placeholder until its variables are set:
# docs/switching-to-gcp.md. Startup and GET /api/health show what is running.

PORT=4000
# The frontend's origin(s), exactly (scheme://host:port). Used for CORS and the
# CSRF check: a signed-in change from any other origin is refused (#490). Add a
# worktree's port here (e.g. http://localhost:3100) to test through it.
ALLOWED_ORIGINS=http://localhost:3000

# ── Sign-in ─ placeholder: anonymous, or dev sign-in (type any allowed email)
# with AUTH_MODE=dev. Google: set both, and leave AUTH_MODE unset.
GOOGLE_OAUTH_CLIENT_ID=
SESSION_SECRET=
ALLOWED_EMAIL_DOMAINS=accenture.com
# Google Workspace domains allowed to sign in (the ID token's `hd`); defaults to
# ALLOWED_EMAIL_DOMAINS. Personal Google accounts have no `hd` and are refused.
# ALLOWED_HOSTED_DOMAINS=accenture.com
# Slack on a Google token's expiry, 0-300 seconds (default 300).
# GOOGLE_ID_TOKEN_CLOCK_SKEW_SECONDS=300
# Key for identity links (Google account -> owner key, #488): at least 32 random
# bytes, hex or base64 (openssl rand -hex 32). Secret Manager when deployed, where
# it's required; unset locally, one is made per start. The version goes in every
# link ID: change it only with a link migration.
# IDENTITY_LINK_HMAC_KEY=
# IDENTITY_LINK_HMAC_KEY_VERSION=1
# AUTH_MODE=dev
# Sessions (#489): jwt (default) is the signed 30-day token. opaque keeps a random
# ID in the cookie and checks it against login_sessions on every request (idle and
# absolute deadlines, revocation, a disabled owner); sign-out revokes it. Switching
# to opaque signs everyone out once. Timeouts in seconds (defaults 7 and 30 days).
# SESSION_MODE=jwt
# SESSION_IDLE_SECONDS=604800
# SESSION_ABSOLUTE_SECONDS=2592000

# ── Data and files ─ placeholder: local disk at .data (LOCAL_DATA_DIR=memory
# for memory only). GCP: set both.
# LOCAL_DATA_DIR=.data
FIRESTORE_PROJECT_ID=
GCS_BUCKET_NAME=
# Local emulators instead (docs/deployment.md, "Local emulators"):
# . emulators/env.sh

# ── AI generation ─ placeholder: offline images, text and video. Vertex AI: set.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global

# ── Video jobs ─ placeholder: in process (on local disk, picked up again after
# a restart). Cloud Tasks: set all three (docs/switching-to-gcp.md).
# CLOUD_TASKS_QUEUE=projects/<project>/locations/<region>/queues/<queue>
# CLOUD_TASKS_SERVICE_ACCOUNT=<tasks account email>
# JOBS_WORKER_URL=https://<backend url>

# ── Support form ─ placeholder: messages kept and logged, not emailed.
# Email: set the first three, plus user and password unless the relay needs
# none. SUPPORT_EMAIL_TO takes several addresses, comma-separated. SMTP_PASS is
# a secret: Secret Manager on Cloud Run (docs/switching-to-gcp.md).
# SUPPORT_EMAIL_TO=support@yourteam.com
# SUPPORT_EMAIL_FROM=no-reply@yourteam.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ── FastAPI (the private Python service, #494) ─ placeholder: in memory, checks
# nothing; a deployed backend refuses it once something calls FastAPI. Real:
# the service's URL. Calls carry the backend's own Google-signed ID token
# (Application Default Credentials), audience = the URL unless set otherwise.
# FASTAPI_BASE_URL=https://<fastapi service>.run.app
# FASTAPI_AUDIENCE=
# Timeouts in ms (defaults: create a job 15000, Skills calls 10000, AI draft helper 30000):
# FASTAPI_JOB_TIMEOUT_MS=15000
# FASTAPI_SKILLS_TIMEOUT_MS=10000
# FASTAPI_HELPER_TIMEOUT_MS=30000

# ── Run admission limits (#493) ─ defaults are today's numbers; the pack's are
# lower (5 Skills, 10 MiB per reference image, 300 KiB of Skills). Lowering is a
# switch-on decision. Bytes unless named otherwise.
# RUN_MAX_ASSETS=5
# RUN_MAX_ASSET_BYTES=26214400
# RUN_MAX_SKILLS=20
# RUN_MAX_SKILL_BYTES=102400
# RUN_MAX_SKILLS_TOTAL_BYTES=409600
# RUN_MAX_INSTRUCTION_CHARS=30000
# RUN_MAX_COUNT=10
# RUN_MAX_PARENTS=10
