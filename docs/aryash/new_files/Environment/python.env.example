# ALL THESE PYTHON NAMES ARE PROPOSED; no verified FastAPI env contract supplied.
# Claude Code MUST inspect completed PY-01..04 service and reuse existing names where present.
PORT=8000
ENVIRONMENT=local
GOOGLE_CLOUD_PROJECT=<gcp-project-id>
GCP_REGION=<region>
CLOUD_SQL_INSTANCE_CONNECTION_NAME=<project:region:instance>
CLOUD_SQL_DATABASE=<database-name>
CLOUD_SQL_USER=<db-user-or-iam-principal>
CLOUD_SQL_PASSWORD=<secret-manager-reference-if-password-auth>
GCS_BUCKET_NAME=<one-private-bucket-name>
BIGQUERY_PROJECT_ID=<gcp-project-id>
BIGQUERY_DATASET=<dataset-name>
CLOUD_TASKS_QUEUE=projects/<project>/locations/<region>/queues/<queue>
CLOUD_TASKS_SERVICE_ACCOUNT=<task-oidc-service-account-email>
JOBS_WORKER_URL=https://<private-fastapi-cloud-run-service>/internal/jobs/execute
WORKER_OIDC_AUDIENCE=https://<private-fastapi-cloud-run-service>
NODE_INVOKER_SERVICE_ACCOUNT=<node-service-account-email>
FASTAPI_WORKER_SERVICE_ACCOUNT=<task-oidc-service-account-email>
VERTEX_PROJECT_ID=<gcp-project-id>
VERTEX_LOCATION=<model-supported-region>
VERTEX_IMAGE_MODEL_ID=<verify-supported-model-id>
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
JOB_TIMEOUT_SECONDS=1500
MODEL_TIMEOUT_SECONDS=240
SINGLE_IMAGE_OUTPUT_COUNT=1
# Explicit local mock only; disabled in production
MOCK_VERTEX=false
