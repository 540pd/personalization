# FastAPI control plane and Cloud Tasks worker only. ALL NEW names are PROPOSED until repo inspection.
PORT=8000
ENVIRONMENT=local
GOOGLE_CLOUD_PROJECT=<gcp-project-id>
GCP_REGION=<region>
CLOUD_SQL_INSTANCE_CONNECTION_NAME=<project:region:instance>
CLOUD_SQL_DATABASE=<database>
CLOUD_SQL_USER=<db-user>
# In production supply DB password (if password auth) via Secret Manager, never literal file value.
CLOUD_SQL_PASSWORD=<secret-manager-managed-if-needed>
GCS_BUCKET_NAME=<single-private-asset-bucket>
BIGQUERY_PROJECT_ID=<gcp-project-id>
BIGQUERY_DATASET=<dataset-name>
CLOUD_TASKS_QUEUE=projects/<project>/locations/<region>/queues/<queue>
CLOUD_TASKS_SERVICE_ACCOUNT=<cloud-tasks-oidc-identity>
JOBS_WORKER_URL=https://<fastapi-cloud-run-service>/internal/jobs/execute
WORKER_OIDC_AUDIENCE=https://<fastapi-cloud-run-service>
NODE_INVOKER_SERVICE_ACCOUNT=<node-oidc-invoker-email>
FASTAPI_WORKER_SERVICE_ACCOUNT=<cloud-tasks-invoker-email>
ADK_AGENT_RUNTIME_RESOURCE=<full-managed-agent-resource-id>
ADK_INVOKE_AUDIENCE=<verify-audience-for-agent-runtime>
ADK_RUNTIME_LOCATION=<supported-agent-runtime-region>
ADK_REQUEST_TIMEOUT_SECONDS=1400
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
JOB_TIMEOUT_SECONDS=1500
SINGLE_IMAGE_OUTPUT_COUNT=1
# FastAPI does not require VERTEX_IMAGE_MODEL_ID; never call image models here.
# LOCAL ONLY
MOCK_ADK=false
