# Private MCP artifact/event gateway, PROPOSED names; no service-account keys.
GOOGLE_CLOUD_PROJECT=<gcp-project-id>
GCP_REGION=<region>
GCS_BUCKET_NAME=<single-private-asset-bucket>
BIGQUERY_PROJECT_ID=<gcp-project-id>
BIGQUERY_DATASET=<dataset-name>
CLOUD_SQL_INSTANCE_CONNECTION_NAME=<project:region:instance>
CLOUD_SQL_DATABASE=<database>
CLOUD_SQL_USER=<db-user>
CLOUD_SQL_PASSWORD=<secret-manager-managed-if-needed>
ADK_INVOKER_IDENTITY=<managed-agent-or-runtime-service-identity>
MCP_TOOL_AUDIENCE=https://<private-mcp-tool-service>
MCP_ALLOWED_TOOLS=artifact.fetch_input,artifact.write_output,events.write
SINGLE_IMAGE_OUTPUT_COUNT=1
# Intentionally DO NOT expose dam.search_candidates: agent DAM search is deferred.
