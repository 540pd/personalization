# Node BFF (do not commit real .env files)
# Existing variables observed in environment inventory:
PORT=4000
GOOGLE_OAUTH_CLIENT_ID=<oauth-web-client-id>
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_EMAIL_DOMAINS=accenture.com
SESSION_SECRET=<secret-manager-or-local-placeholder>
FIRESTORE_PROJECT_ID=<gcp-project-id>
GCS_BUCKET_NAME=<one-private-bucket-name>
# Legacy Vertex keys may exist in current checkout; new Run must NOT call Vertex from Node.
# VERTEX_PROJECT_ID=<legacy-only-if-needed>
# VERTEX_LOCATION=global
# PROPOSED integration variables: verify with actual repository before wiring:
FASTAPI_BASE_URL=http://localhost:8000
CLOUD_SQL_INSTANCE_CONNECTION_NAME=<project:region:instance>
CLOUD_SQL_DATABASE=<database-name>
CLOUD_SQL_USER=<db-user-or-iam-principal>
CLOUD_SQL_PASSWORD=<secret-manager-reference-if-password-auth>
BIGQUERY_PROJECT_ID=<gcp-project-id>
BIGQUERY_DATASET=<dataset-name>
GCP_REGION=<region>
# Auth mode may support a dev-only setting; never deploy AUTH_MODE=dev or IAP_PROTECTED without IAP.
# Cloud Tasks should be dispatched by FastAPI in the NEW architecture; old Node Cloud Tasks variables
# CLOUD_TASKS_QUEUE / CLOUD_TASKS_SERVICE_ACCOUNT / JOBS_WORKER_URL may remain for legacy video only.

