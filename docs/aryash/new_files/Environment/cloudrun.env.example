# Safe non-secret deployment values ONLY. Use Secret Manager for credentials.
GCP_PROJECT_ID=<project-id>
GCP_REGION=<region>
GCS_BUCKET_NAME=<single-private-bucket>
BIGQUERY_DATASET=<dataset-name>
CLOUD_SQL_INSTANCE_CONNECTION_NAME=<project:region:instance>
NODE_BFF_SERVICE_ACCOUNT=<node-sa-email>
FASTAPI_SERVICE_ACCOUNT=<python-sa-email>
CLOUD_TASKS_SERVICE_ACCOUNT=<task-sa-email>
CLOUD_TASKS_QUEUE=projects/<project>/locations/<region>/queues/<queue>
NODE_URL=https://<node-service>
FASTAPI_BASE_URL=https://<python-service>
# Configure per-service actual env map, not one shared literal file for all roles.
