# Google ADK / managed Agent Runtime; PROPOSED variable names, verify SDK and existing repo.
GOOGLE_CLOUD_PROJECT=<gcp-project-id>
ADK_RUNTIME_LOCATION=<supported-region>
ADK_AGENT_RUNTIME_RESOURCE=<full-managed-agent-resource-id>
ADK_SESSION_SERVICE_RESOURCE=<managed-session-resource-if-applicable>
VERTEX_PROJECT_ID=<gcp-project-id>
VERTEX_LOCATION=<model-supported-region>
VERTEX_PLAN_MODEL_ID=<available-gemini-model-id>
VERTEX_IMAGE_MODEL_ID=<available-vertex-image-model-id>
MODEL_TIMEOUT_SECONDS=240
ADK_PLAN_MAX_CALLS=1
ADK_IMAGE_MAX_CALLS=1
ADK_MAX_TOOL_CALLS=8
SINGLE_IMAGE_OUTPUT_COUNT=1
MCP_TOOL_SERVER_URL=https://<private-mcp-tool-service>
MCP_TOOL_AUDIENCE=https://<private-mcp-tool-service>
SKILLS_REGISTRY_LOCATION=<registry-region>
SKILLS_MAX_SELECTED=5
SKILLS_MAX_TOTAL_BYTES=307200
SKILLS_MAX_INSTRUCTION_CHARS=30000
# LOCAL MOCK ONLY: no model billing
MOCK_VERTEX=false
